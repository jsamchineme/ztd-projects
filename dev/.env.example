# Copy to dev/.env and fill in. dev/.env is gitignored (never committed).
# Known admin password for the local Stalwart web admin (http://localhost:8080, user: admin).
STALWART_ADMIN_PASSWORD=ztdmail-dev-admin

# Your Resend API key — used by Stalwart as the SMTP relay password for OUTBOUND mail.
# Internal mailbox-to-mailbox mail works WITHOUT this; only outbound-to-real-addresses needs it.
RESEND_API_KEY=
