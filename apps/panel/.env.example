# Postgres connection (Neon or any Postgres). If unset, the app uses an in-process PGlite
# database under .pglite/ — handy for local development and tests, not for production.
DATABASE_URL=

# Public URL of the panel, used in invite links.
APP_URL=https://admin.ztdoffice.com

# Mail server (Stalwart) admin API. Leave MODE=fake for local dev/tests.
STALWART_MODE=fake
STALWART_URL=
STALWART_API_KEY=

# Licence display
LICENCE_SEATS=25
LICENCE_RENEWS=2026-11-19
MAIL_HOST=mx1.ztdoffice.com
