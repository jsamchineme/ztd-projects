{
  "expo": {
    "name": "ZTD Studio",
    "slug": "ztd-studio-phone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ztddevs.studio",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ztddevs.studio",
      "adaptiveIcon": {
        "backgroundColor": "#00427c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the pairing code on Studio’s Account page.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00427c"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "13ca0973-4369-458f-b5da-dbaeb85ef01c"
      }
    },
    "owner": "jsamchineme",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/13ca0973-4369-458f-b5da-dbaeb85ef01c"
    }
  }
}
