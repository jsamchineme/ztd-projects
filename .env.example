# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres (docker-compose) for development:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/debbskitchen"
# Production (Neon) — set in the Studio service envs, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.neon.tech/debbskitchen?sslmode=require"
# lib/db.ts auto-selects the Neon serverless adapter when the host contains "neon.tech".

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:4402"
# Production: NEXTAUTH_URL="https://debbskitchen.ztddevs.com"

# ─── Media storage ───────────────────────────────────────────────────────────
# When these are set, uploads go to Cloudinary; otherwise they are written to
# public/uploads/ locally (Sharp-optimized) for development.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder (within Cloudinary) that all uploads are saved under. Defaults to "debbskitchen".
# Supports nested paths, e.g. "debbskitchen/products".
CLOUDINARY_FOLDER="debbskitchen"

# ─── Email (optional — contact form notifications) ───────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_EMAIL=""

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Set NODE_ENV=production in the Studio service env for production builds.
PORT="4402"
